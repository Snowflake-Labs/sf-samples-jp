# Snowflake connection
# Python スクリプトが使う ~/.snowflake/connections.toml の接続名（省略すると既定の接続になる）
SNOWFLAKE_CONNECTION_NAME=<YOUR_CONNECTION_NAME>
SNOWFLAKE_ACCOUNT=<YOUR_SNOWFLAKE_ACCOUNT>
SNOWFLAKE_USER=<YOUR_USER>
SNOWFLAKE_WAREHOUSE=HR_APP_WH
SNOWFLAKE_DATABASE=HR_ANALYTICS
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_PAT=<YOUR_PAT_TOKEN>

# Snowflake Postgres
POSTGRES_HOST=<YOUR_PG_INSTANCE>.postgres.snowflake.app
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=<YOUR_PG_USER>
POSTGRES_PASSWORD=<YOUR_PG_PASSWORD>

# SPCS deployment settings (optional)
SPCS_REGISTRY=<YOUR_ACCOUNT>.registry.snowflakecomputing.com
SPCS_IMAGE_REPO=
SPCS_COMPUTE_POOL=
SPCS_SERVICE=
SPCS_EAI=
SPCS_PAT_SECRET=
SPCS_PG_PASSWORD_SECRET=
