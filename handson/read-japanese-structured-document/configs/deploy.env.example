# ローカル設定のひな型。`cp configs/deploy.env.example configs/deploy.local.env` してから値を埋める。
# deploy.local.env は git 管理外（.gitignore）。接続名・パスをリポジトリに書かないこと。

# Snowflake CLI の接続名（config.toml の接続の名前）。環境変数 SNOWFLAKE_CONNECTION_NAME があればそちらが優先される
CONNECTION_NAME=<your_connection>

# データセットは既定で Hugging Face（公開・CC BY 4.0）から取得するので、以下は書かなくてよい。
# configs/corpora/<name>.yaml の source.kind を local にしたとき（開発用・ネットワークに出られない環境）だけ、
# データセットの置き場所（manifest.json がある階層）を書く
# DATA_ROOT_YAKKAN=<path/to/yakkan-dataset>
# DATA_ROOT_CONTRACT=<path/to/contract-dataset>

# Hugging Face のトークン（任意）。公開リポジトリなので不要。レート制限に当たるときだけ使う。環境変数 HF_TOKEN でもよい
# HF_TOKEN=<your_hf_token>
