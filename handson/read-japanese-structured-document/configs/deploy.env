# デプロイ設定。オブジェクト名の唯一の出所。
# 接続名はここに書かない（configs/deploy.local.env か環境変数 SNOWFLAKE_CONNECTION_NAME）。
#
# NAME_PREFIX だけを書き、DB・スキーマ・ロール・WH・プールの名前は jpdocread.common.names が組み立てる。
# setup.sh / start.sh / teardown.sh と sql/ のテンプレート変数も同じ規則で組み立てる。

NAME_PREFIX=JA_DOC_STRUCTURED_

WAREHOUSE_SIZE=XSMALL
WAREHOUSE_AUTO_SUSPEND=60

COMPUTE_POOL_FAMILY=CPU_X64_S
COMPUTE_POOL_MIN_NODES=1
COMPUTE_POOL_MAX_NODES=2
COMPUTE_POOL_AUTO_SUSPEND_SECS=300

IMAGE_NAME=jpdocread
