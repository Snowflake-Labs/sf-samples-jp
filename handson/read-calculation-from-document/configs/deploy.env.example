# デプロイ設定のひな型。configs/deploy.local.env にコピーして値を入れる（deploy.local.env は git 管理外）。
# このファイルには実在の接続名・アカウント識別子・ユーザー名・資格情報を書かない。

# snow connection list に表示される接続名（SNOWFLAKE_CONNECTION_NAME が設定されていればそちらを優先する）
CONNECTION_NAME=<your_connection>

# 取得元が local のときだけ使う（開発用）。Hugging Face から取得するときは不要
# DATA_ROOT_YAKKAN=<path_to_insurance_dataset>
# DATA_ROOT_CONTRACT=<path_to_contract_dataset>
