{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouteResult",
  "description": "Output of TMS_ROUTER_AGENT.",
  "type": "object",
  "required": [
    "route",
    "confidence",
    "reason",
    "extracted_task_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "route": {
      "enum": [
        "intake",
        "status",
        "change",
        "human"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "extracted_task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T-[0-9]+$"
      }
    }
  }
}
