# コピーして .env を作成してください（.env は git 管理外）。値はすべてプレースホルダーです。
MAP_CONNECTION=<your_connection>

# オブジェクト名（省略時は以下の既定値）
# MAP_DATABASE=MULTI_AGENT_PATTERNS            # パターン 01-04 と共通基盤
# MAP_WAREHOUSE=MULTI_AGENT_PATTERNS_WH        # 全パターン共通
# MAP_ROLE=MULTI_AGENT_PATTERNS_ROLE           # パターン 01-04 の実行ロール
# MAP_MCP_DATABASE=MAP_MCP_CHAIN               # パターン 05
# MAP_SKILL_DATABASE=MAP_SKILL_COMPOSITION     # パターン 06
# MAP_WAREHOUSE_SIZE=XSMALL
# MAP_AUTO_SUSPEND=60

# true のときだけ ALTER ACCOUNT SET CORTEX_ENABLED_CROSS_REGION = 'ANY_REGION' を実行（DISABLED の場合）
# MAP_ENABLE_CROSS_REGION=false

# run_patterns.py / run.sh の繰り返し回数
# MAP_RUNS=3

# 公開前チェック（scripts/check_public.sh）で検出したい文字列を | 区切りで（開発者のローカルのみ）
# MAP_DENYLIST='<your_account>|<your_user>|<your_connection>'
