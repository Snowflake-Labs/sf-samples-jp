# Copy this file to .env. The .env file is ignored by Git, and all values below are placeholders.
MAP_CONNECTION=<your_connection>

# Object names (defaults shown below)
# MAP_DATABASE=MULTI_AGENT_PATTERNS            # Common foundation and patterns 01-04
# MAP_WAREHOUSE=MULTI_AGENT_PATTERNS_WH        # Shared by all patterns
# MAP_ROLE=MULTI_AGENT_PATTERNS_ROLE           # Execution role for patterns 01-04
# MAP_MCP_DATABASE=MAP_MCP_CHAIN               # Pattern 05
# MAP_SKILL_DATABASE=MAP_SKILL_COMPOSITION     # Pattern 06
# MAP_WAREHOUSE_SIZE=XSMALL
# MAP_AUTO_SUSPEND=60

# Run ALTER ACCOUNT SET CORTEX_ENABLED_CROSS_REGION = 'ANY_REGION' only when true and currently disabled.
# MAP_ENABLE_CROSS_REGION=false

# Number of iterations for run_patterns.py and run.sh
# MAP_RUNS=3

# Pipe-separated strings for scripts/check_public.sh to detect (local development only)
# MAP_DENYLIST='<your_account>|<your_user>|<your_connection>'
